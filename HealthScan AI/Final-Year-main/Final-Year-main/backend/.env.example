PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/healthscan
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Optional: appointment reminder emails (nodemailer). Leave unset to simply
# log reminders instead of emailing them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
